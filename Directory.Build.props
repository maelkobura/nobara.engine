<Project>

  <!--
    Test and benchmark projects are not published: they are exempt from the
    documentation rules below. Any other project can opt out explicitly by
    setting NobaraPublishedProject to false.
  -->
  <PropertyGroup>
    <NobaraPublishedProject Condition="'$(NobaraPublishedProject)' == '' And ($(MSBuildProjectName.EndsWith(`.Tests`)) Or $(MSBuildProjectName.EndsWith(`.Benchmarks`)))">false</NobaraPublishedProject>
    <NobaraPublishedProject Condition="'$(NobaraPublishedProject)' == ''">true</NobaraPublishedProject>
  </PropertyGroup>

  <!-- Every public member of a published project must have an XML comment. -->
  <PropertyGroup Condition="'$(NobaraPublishedProject)' == 'true'">
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <WarningsAsErrors>$(WarningsAsErrors);CS1591</WarningsAsErrors>
  </PropertyGroup>

</Project>
