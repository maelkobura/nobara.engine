<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Builds the MSBuild SDK package. The package holds the SDK files (Sdk/) and
    the build task assembly (tasks/). It is a development dependency: it has
    no NuGet dependencies of its own, because MSBuild SDKs are not restored
    transitively.
  -->
  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>

    <Version>1.0.0</Version>
    <PackageId>Nobara.Sdk</PackageId>
    <PackageType>MSBuildSDK</PackageType>
    <Description>MSBuild SDK that turns a project and its module.nobara file into a Nobara module.</Description>
    <PackageLicenseExpression>MPL-2.0</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <DevelopmentDependency>true</DevelopmentDependency>
    <SuppressDependenciesWhenPacking>true</SuppressDependenciesWhenPacking>
    <IncludeSymbols>false</IncludeSymbols>
    <NoPackageAnalysis>true</NoPackageAnalysis>

    <!-- The task assembly goes to tasks/netstandard2.0/. -->
    <BuildOutputTargetFolder>tasks</BuildOutputTargetFolder>
    <AllowedOutputExtensionsInPackageBuildOutputFolder>.dll</AllowedOutputExtensionsInPackageBuildOutputFolder>
  </PropertyGroup>

  <ItemGroup>
    <!-- MSBuild provides these assemblies at run time. -->
    <PackageReference Include="Microsoft.Build.Utilities.Core" Version="17.14.28" PrivateAssets="all" ExcludeAssets="runtime" />
    <InternalsVisibleTo Include="Nobara.Sdk.Tests" />
  </ItemGroup>

  <ItemGroup>
    <None Include="Sdk\**" Pack="true" PackagePath="Sdk" />
    <None Include="README.md" Pack="true" PackagePath="" />
  </ItemGroup>

  <!--
    module.nobara has one definition: the reader of the resource compiler.
    Its files are compiled into this assembly, which MSBuild loads while it
    evaluates every module, so they stay compatible with netstandard2.0.
  -->
  <ItemGroup>
    <Compile Include="..\Nobara.ResourceCompiler\Diagnostics\Diagnostic.cs" Link="Shared\Diagnostic.cs" />
    <Compile Include="..\Nobara.ResourceCompiler\Manifests\ManifestModel.cs" Link="Shared\ManifestModel.cs" />
    <Compile Include="..\Nobara.ResourceCompiler\Manifests\ManifestXml.cs" Link="Shared\ManifestXml.cs" />
    <Compile Include="..\Nobara.ResourceCompiler\Manifests\ModuleManifestReader.cs" Link="Shared\ModuleManifestReader.cs" />
    <Compile Include="..\Nobara.ResourceCompiler\Manifests\SemanticVersion.cs" Link="Shared\SemanticVersion.cs" />
    <Compile Include="..\Nobara.ResourceCompiler\Manifests\VersionRange.cs" Link="Shared\VersionRange.cs" />
  </ItemGroup>

  <!--
    The resource compiler task and its dependencies go to tasks/net10.0/, and
    the options that schemas import go to protos/.
  -->
  <ItemGroup>
    <ProjectReference Include="..\Nobara.ResourceCompiler.MSBuild\Nobara.ResourceCompiler.MSBuild.csproj" ReferenceOutputAssembly="false" PrivateAssets="all" SkipGetTargetFrameworkProperties="true" GlobalPropertiesToRemove="TargetFramework" />
    <None Include="..\Nobara.ResourceCompiler\Protos\nobara\options.proto" Pack="true" PackagePath="protos\nobara" Link="protos\nobara\options.proto" />
  </ItemGroup>

  <PropertyGroup>
    <TargetsForTfmSpecificContentInPackage>$(TargetsForTfmSpecificContentInPackage);NobaraPackResourceCompiler</TargetsForTfmSpecificContentInPackage>
  </PropertyGroup>

  <Target Name="NobaraPackResourceCompiler">
    <MSBuild Projects="..\Nobara.ResourceCompiler.MSBuild\Nobara.ResourceCompiler.MSBuild.csproj" Targets="Build" RemoveProperties="TargetFramework">
      <Output TaskParameter="TargetOutputs" ItemName="_NobaraCompilerTaskAssembly" />
    </MSBuild>
    <ItemGroup>
      <_NobaraCompilerTaskFile Include="%(_NobaraCompilerTaskAssembly.RootDir)%(_NobaraCompilerTaskAssembly.Directory)*.dll" />
      <_NobaraCompilerTaskFile Include="%(_NobaraCompilerTaskAssembly.RootDir)%(_NobaraCompilerTaskAssembly.Directory)*.deps.json" />
      <TfmSpecificPackageFile Include="@(_NobaraCompilerTaskFile)" PackagePath="tasks\net10.0" />
    </ItemGroup>
  </Target>

  <!--
    The engine analyzers ship inside this package, in analyzers/, because an
    MSBuild SDK cannot bring package dependencies. Sdk.targets attaches them.
  -->
  <ItemGroup>
    <ProjectReference Include="..\Nobara.Analyzers\Nobara.Analyzers.csproj" ReferenceOutputAssembly="false" PrivateAssets="all" />
  </ItemGroup>

  <PropertyGroup>
    <TargetsForTfmSpecificContentInPackage>$(TargetsForTfmSpecificContentInPackage);NobaraPackAnalyzers</TargetsForTfmSpecificContentInPackage>
  </PropertyGroup>

  <Target Name="NobaraPackAnalyzers">
    <MSBuild Projects="..\Nobara.Analyzers\Nobara.Analyzers.csproj" Targets="Build" RemoveProperties="TargetFramework">
      <Output TaskParameter="TargetOutputs" ItemName="_NobaraAnalyzerAssembly" />
    </MSBuild>
    <ItemGroup>
      <TfmSpecificPackageFile Include="@(_NobaraAnalyzerAssembly)" PackagePath="analyzers" />
    </ItemGroup>
  </Target>

  <!--
    The global packages folder keeps an extracted copy of every package
    version, and MSBuild resolves the SDK from that copy. Remove the copy of
    this version after packing so that the next restore extracts the new one.
  -->
  <Target Name="NobaraDropCachedSdk" AfterTargets="Pack">
    <RemoveDir Directories="$(NuGetPackageRoot)$(PackageId.ToLowerInvariant())\$(PackageVersion)" Condition="'$(NuGetPackageRoot)' != ''" />
  </Target>

</Project>
