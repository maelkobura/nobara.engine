<Project Sdk="Nobara.Sdk/1.0.0">

  <!--
    The resource plugin of the types Sound and Bus, loaded by the resource
    compiler when a module that depends on nobara.audio is built. It converts
    WAV and FLAC sources to Ogg Vorbis with Nobara.AudioToolkit, whose native
    encoder (libvorbis) runs at build time only. It is never shipped with a
    game, nor is the toolkit.
  -->
  <PropertyGroup>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>false</IsPackable>
    <!-- The compiler loads the plugin from its folder: the toolkit, managed and native, is copied next to it. -->
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Nobara.Audio\Nobara.Audio.csproj" />
    <ProjectReference Include="..\..\..\tools\Nobara.ResourceCompiler\Nobara.ResourceCompiler.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Nobara.Audio.Tests" />
  </ItemGroup>

  <ItemGroup>
    <!-- Private: a module that depends on nobara.audio, and its game, never receive the toolkit. -->
    <PackageReference Include="Nobara.AudioToolkit" Version="0.1.0" PrivateAssets="all" />
  </ItemGroup>

</Project>
