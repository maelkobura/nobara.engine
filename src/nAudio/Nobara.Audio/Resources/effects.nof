<Nobara version="1.0.0" namespace="Nobara/Audio/Effects">
  <!-- The children of bus:nobara.audio.effects, which the player adjusts together. -->
  <Bus>
    <Name>Blocks</Name>
    <Content>
      <Parent>bus:nobara.audio.effects</Parent>
    </Content>
  </Bus>

  <Bus>
    <Name>Entities</Name>
    <Content>
      <Parent>bus:nobara.audio.effects</Parent>
    </Content>
  </Bus>

  <Bus>
    <Name>Players</Name>
    <Content>
      <Parent>bus:nobara.audio.effects</Parent>
    </Content>
  </Bus>
</Nobara>
