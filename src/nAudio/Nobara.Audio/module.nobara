<NobaraModule format="1">
  <Id>nobara.audio</Id>
  <ShortName>Audio</ShortName>
  <Version>1.0.0</Version>
  <Level>platform</Level>
  <Side>both</Side>

  <Dependencies>
    <Module id="nobara.game" version="^1.0" optional="true" />
    <Module id="nobara.debug" version="^1.0" optional="true" />
    <Module id="nobara.renderer" version="^1.0" optional="true" />
  </Dependencies>

  <RequiresBackend side="client" />

  <Libraries>
    <Package id="NVorbis" version="0.10.5" />
  </Libraries>

  <Settings>
    <Setting key="audio.backend" scope="user" type="string" default="auto" side="client" />
    <Setting key="audio.hrtf" scope="user" type="enum" values="auto,on,off" default="auto" side="client" />
    <Setting key="audio.realVoices" scope="distribution" type="int" min="1" max="4096" default="64" side="client" />
    <Setting key="audio.maxInstances" scope="distribution" type="int" min="0" default="32" side="client" />
  </Settings>
</NobaraModule>
