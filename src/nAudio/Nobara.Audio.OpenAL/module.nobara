<NobaraModule format="1">
  <Id>nobara.audio.openal</Id>
  <ShortName>AudioOpenAL</ShortName>
  <Version>1.0.0</Version>
  <Level>platform</Level>
  <Side>client</Side>

  <Dependencies>
    <Module id="nobara.audio" version="^1.0" />
  </Dependencies>

  <Libraries>
    <Package id="Silk.NET.OpenAL" version="2.23.0" />
    <Package id="Silk.NET.OpenAL.Extensions.Creative" version="2.23.0" />
    <Package id="Silk.NET.OpenAL.Soft.Native" version="1.23.1" />
  </Libraries>

  <BackendOf module="nobara.audio" />
</NobaraModule>
