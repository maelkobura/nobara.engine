<Nobara version="1.0.0" namespace="Nobara">
  <!--
    block:nobara.air, state 0 of every registry: no shape, no collision,
    nothing to draw, never broken, no item.
  -->
  <Block>
    <Name>Air</Name>
    <Content>
      <Collision>none</Collision>
      <Hardness>unbreakable</Hardness>
    </Content>
  </Block>
</Nobara>
