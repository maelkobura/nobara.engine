<NobaraModule format="1">
  <Id>nobara.debug</Id>
  <ShortName>Debug</ShortName>
  <Version>1.0.0</Version>
  <Level>platform</Level>
  <Side>client</Side>

  <Dependencies>
    <Module id="nobara.renderer" version="^1.0" />
    <Module id="nobara.input" version="^1.0" />
    <Module id="nobara.graphics" version="^1.0" />
    <Module id="nobara.frames" version="^1.0" />
  </Dependencies>

  <Libraries>
    <Package id="ImGui.NET" version="1.91.6.1" />
  </Libraries>

  <Settings>
    <Setting key="debug.tools" scope="distribution" type="enum" values="development,always,never" default="development" side="client" />
  </Settings>
</NobaraModule>
