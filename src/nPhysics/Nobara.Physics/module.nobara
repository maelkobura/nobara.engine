<NobaraModule format="1">
  <Id>nobara.physics</Id>
  <ShortName>Physics</ShortName>
  <Version>1.0.0</Version>
  <Level>platform</Level>
  <Side>both</Side>

  <Dependencies>
    <Module id="nobara.game" version="^1.0" />
    <Module id="nobara.context" version="^1.0" />
    <Module id="nobara.entity" version="^1.0" />
    <Module id="nobara.voxel" version="^1.0" />
    <Module id="nobara.blocks" version="^1.0" />
    <Module id="nobara.debug" version="^1.0" optional="true" />
    <Module id="nobara.renderer" version="^1.0" optional="true" />
    <Module id="nobara.graphics" version="^1.0" optional="true" />
  </Dependencies>

  <Reserves>
    <Resource name="voxel.grid.transform" />
  </Reserves>

  <RequiresBackend side="both" />

  <Settings>
    <Setting key="physics.backend" scope="distribution" type="string" default="auto" />
    <Setting key="physics.substeps" scope="distribution" type="int" min="1" max="32" default="8" />
    <Setting key="physics.velocityIterations" scope="distribution" type="int" min="1" max="16" default="1" />
  </Settings>
</NobaraModule>
