<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <!-- The dispatcher of BEPUphysics takes pointers. -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.5" />
  </ItemGroup>

  <!--
    The tests run the real modules from nGame to nVoxel, nPhysics, and the
    BEPUphysics backend on a server context, with the real job system. The
    resource compiler provides the compiled formats of the manifests.
  -->
  <ItemGroup>
    <ProjectReference Include="..\Nobara.Physics.Bepu\Nobara.Physics.Bepu.csproj" />
    <ProjectReference Include="..\Nobara.Physics\Nobara.Physics.csproj" />
    <ProjectReference Include="..\..\nVoxel\Nobara.Voxel\Nobara.Voxel.csproj" />
    <ProjectReference Include="..\..\Core\Nobara.Core\Nobara.Core.csproj" />
    <ProjectReference Include="..\..\..\tools\Nobara.ResourceCompiler\Nobara.ResourceCompiler.csproj" />
    <ProjectReference Include="..\..\nItems\Nobara.Items.Build\Nobara.Items.Build.csproj" />
    <ProjectReference Include="..\..\nBlocks\Nobara.Blocks.Build\Nobara.Blocks.Build.csproj" />
  </ItemGroup>

</Project>
