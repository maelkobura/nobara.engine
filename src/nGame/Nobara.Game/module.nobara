<NobaraModule format="1">
  <Id>nobara.game</Id>
  <ShortName>Game</ShortName>
  <Version>1.0.0</Version>
  <Level>platform</Level>
  <Side>both</Side>

  <Dependencies>
    <Module id="nobara.event" version="^1.0" optional="true" />
  </Dependencies>

  <Reserves>
    <Resource name="loop.simulation" />
  </Reserves>
</NobaraModule>
