<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.5" />
    <PackageReference Include="Grpc.Tools" Version="2.80.0" PrivateAssets="all" IncludeAssets="runtime; build; native; contentfiles; analyzers; buildtransitive" />
  </ItemGroup>

  <!--
    Test schemas. They import the options of the compiler, whose generated
    classes come from the referenced compiler.
  -->
  <ItemGroup>
    <Protobuf Include="Schemas/*.proto" ProtoRoot="Schemas" GrpcServices="None" AdditionalImportDirs="../../../tools/Nobara.ResourceCompiler/Protos" />
  </ItemGroup>

  <!-- The resource compiler gives the tests the compiled manifest formats. -->
  <ItemGroup>
    <ProjectReference Include="..\Nobara.Core\Nobara.Core.csproj" />
    <ProjectReference Include="..\..\..\tools\Nobara.ResourceCompiler\Nobara.ResourceCompiler.csproj" />
  </ItemGroup>

  <!--
    Sample modules built with Nobara.Sdk by the tests themselves, in a
    scratch folder: they are copied next to the test assembly, not compiled
    into it.
  -->
  <ItemGroup>
    <Compile Remove="TestModules/**" />
    <None Remove="TestModules/**" />
    <None Include="TestModules/**" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
