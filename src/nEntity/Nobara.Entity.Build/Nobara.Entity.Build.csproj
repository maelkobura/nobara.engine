<Project Sdk="Nobara.Sdk/1.0.0">

  <!--
    The resource plugin of the type Entity, loaded by the resource compiler when
    a module that depends on nobara.entity is built. It is never shipped with
    a game.
  -->
  <PropertyGroup>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Nobara.Entity\Nobara.Entity.csproj" />
    <ProjectReference Include="..\..\..\tools\Nobara.ResourceCompiler\Nobara.ResourceCompiler.csproj" />
  </ItemGroup>

</Project>
