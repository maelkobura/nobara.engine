<Project Sdk="Nobara.Sdk/1.0.0">

  <!--
    The resource plugin of the types InputAction and InputMap, loaded by the
    resource compiler when a module that depends on nobara.input is built. It
    is never shipped with a game.
  -->
  <PropertyGroup>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Nobara.Input\Nobara.Input.csproj" />
    <ProjectReference Include="..\..\..\tools\Nobara.ResourceCompiler\Nobara.ResourceCompiler.csproj" />
  </ItemGroup>

</Project>
