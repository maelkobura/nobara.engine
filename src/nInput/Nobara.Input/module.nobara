<NobaraModule format="1">
  <Id>nobara.input</Id>
  <ShortName>Input</ShortName>
  <Version>1.0.0</Version>
  <Level>platform</Level>
  <Side>client</Side>

  <Dependencies>
    <Module id="nobara.frames" version="^1.0" />
  </Dependencies>

  <Settings>
    <Setting key="input.mouseSensitivity" scope="user" type="float" min="0.01" max="100" default="1" side="client" />
    <Setting key="input.invertY" scope="user" type="bool" default="false" side="client" />
  </Settings>
</NobaraModule>
