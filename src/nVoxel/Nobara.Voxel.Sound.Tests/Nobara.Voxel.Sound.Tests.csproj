<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.5" />
    <!-- The plugin of nAudio keeps the toolkit to itself; the tests run the plugin in their own process. -->
    <PackageReference Include="Nobara.AudioToolkit" Version="0.1.0" />
  </ItemGroup>

  <!--
    The tests write the resources of a test game (sounds and blocks that name
    them), compile them with the plugins of nAudio, nItems, and nBlocks, then
    run the real modules from nGame to nVoxel and nAudio, with
    nVoxel.Sound, on a client with a backend of nAudio that plays nothing and
    records what it is asked.
  -->
  <ItemGroup>
    <ProjectReference Include="..\Nobara.Voxel.Sound\Nobara.Voxel.Sound.csproj" />
    <ProjectReference Include="..\Nobara.Voxel\Nobara.Voxel.csproj" />
    <ProjectReference Include="..\..\nAudio\Nobara.Audio\Nobara.Audio.csproj" />
    <ProjectReference Include="..\..\nAudio\Nobara.Audio.Build\Nobara.Audio.Build.csproj" />
    <ProjectReference Include="..\..\nItems\Nobara.Items.Build\Nobara.Items.Build.csproj" />
    <ProjectReference Include="..\..\nBlocks\Nobara.Blocks.Build\Nobara.Blocks.Build.csproj" />
    <ProjectReference Include="..\..\Core\Nobara.Core\Nobara.Core.csproj" />
    <ProjectReference Include="..\..\..\tools\Nobara.ResourceCompiler\Nobara.ResourceCompiler.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Include="Resources\**" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
