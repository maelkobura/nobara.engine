<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.5" />
  </ItemGroup>

  <!--
    The mesher is tested alone on copies of chunks that the tests fill. The
    other tests write the resources of a test game (blocks, textures, meshes),
    compile them with the plugins of nItems, nBlocks, and nRenderer, then run
    the real modules from nGame to nVoxel and from nFrames to nRenderer, on
    fake window and graphics backends, with nVoxel.Renderer.
  -->
  <ItemGroup>
    <ProjectReference Include="..\Nobara.Voxel.Renderer\Nobara.Voxel.Renderer.csproj" />
    <ProjectReference Include="..\Nobara.Voxel\Nobara.Voxel.csproj" />
    <ProjectReference Include="..\..\nItems\Nobara.Items.Build\Nobara.Items.Build.csproj" />
    <ProjectReference Include="..\..\nBlocks\Nobara.Blocks.Build\Nobara.Blocks.Build.csproj" />
    <ProjectReference Include="..\..\nRenderer\Nobara.Renderer\Nobara.Renderer.csproj" />
    <ProjectReference Include="..\..\nRenderer\Nobara.Renderer.Build\Nobara.Renderer.Build.csproj" />
    <ProjectReference Include="..\..\nGraphics\Nobara.Graphics\Nobara.Graphics.csproj" />
    <ProjectReference Include="..\..\nFrames\Nobara.Frames\Nobara.Frames.csproj" />
    <ProjectReference Include="..\..\Core\Nobara.Core\Nobara.Core.csproj" />
    <ProjectReference Include="..\..\..\tools\Nobara.ResourceCompiler\Nobara.ResourceCompiler.csproj" />
  </ItemGroup>

</Project>
